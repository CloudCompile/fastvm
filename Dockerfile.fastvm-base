FROM ghcr.io/linuxserver/baseimage-kasmvnc:ubuntujammy AS build

ARG BUILD_DATE
ARG VERSION=alpha
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="FastVM shared base (alpha)" \
      org.opencontainers.image.description="Shared XFCE4/FastVM runtime base for alpha preset images" \
      org.opencontainers.image.source="https://github.com/CloudCompile/fastvm" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

ENV NODE_ENV=production

# Runtime files and scripts are shared by every preset image. The scripts are
# copied before fastvm-setup.sh because setup uses gpu-session-env.sh when it
# patches the desktop startup script.
COPY root/ /
COPY scripts/ /fastvm-scripts/
RUN chmod +x /fastvm-scripts/*.sh

# Shared system dependencies. Keep application bundles out of this image.
RUN set -eu && \
    rm -f /etc/apt/sources.list.d/nodesource.list || true && \
    apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    add-apt-repository -y universe multiverse && \
    add-apt-repository -y ppa:mozillateam/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      jq wget curl ca-certificates apt-transport-https \
      pulseaudio pulseaudio-utils libpulse0 ffmpeg x11-utils \
      xclip xsel cron zstd procps net-tools && \
    rm -rf /var/lib/apt/lists/*

COPY dashboard/ /opt/fastvm-dashboard/
WORKDIR /opt/fastvm-dashboard
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

RUN set -eu && \
    apt-get autoclean && apt-get autoremove -y && \
    rm -rf /config/.cache /var/lib/apt/lists/* /var/tmp/* /tmp/* /var/log/* \
      /usr/share/doc/* /usr/share/man/* && \
    # ---- OS library trim (no runtime impact) ------------------------------
    # Keep only en_US.UTF-8 (+ glibc's built-in C/POSIX/C.UTF-8): the upstream
    # image ships a ~394 MB locale archive plus ~500 compiled locale dirs.
    rm -f /usr/lib/locale/locale-archive && \
    localedef -i en_US -f UTF-8 en_US.UTF-8 && \
    find /usr/lib/locale -mindepth 1 -maxdepth 1 -type d ! -name 'en_US*' \
      -exec rm -rf {} + && \
    rm -rf /usr/share/locale && mkdir -p /usr/share/locale/en \
      /usr/share/locale/en_US/LC_MESSAGES && \
    # C headers are build-time only.
    rm -rf /usr/include/* && \
    # Static archives are link-time only.
    find /usr/lib /usr/local/lib -name '*.a' -type f -delete 2>/dev/null || true && \
    # ---------------------------------------------------------------------------
    mkdir -p /var/log/fastvm /config /config/backups /config/recordings \
      /config/.fastvm /var/log/nginx && \
    chown -R 1000:1000 /config && chown -R www-data:www-data /var/log/nginx && \
    chmod +x /etc/cont-init.d/99-fastvm-init \
      /etc/services.d/fastvm-dashboard/run 2>/dev/null || true

# =============================================================================
# Flatten: repackage the trimmed filesystem into a single layer. Without this,
# deletions above cannot shrink the image (the upstream layers still carry the
# data, e.g. the ~394 MB locale archive). Metadata below mirrors the upstream
# baseimage exactly.
# =============================================================================
FROM scratch
ARG BUILD_DATE
ARG VERSION=alpha

COPY --from=build / /

LABEL org.opencontainers.image.title="FastVM shared base" \
      org.opencontainers.image.description="Desktop-neutral shared FastVM runtime base, trimmed single-layer" \
      org.opencontainers.image.source="https://github.com/CloudCompile/fastvm" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# Mirrors ghcr.io/linuxserver/baseimage-kasmvnc:ubuntujammy config.
ENV PATH=/lsiopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/config \
    LANGUAGE=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    TERM=xterm \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=1 \
    S6_STAGE2_HOOK=/docker-mods \
    VIRTUAL_ENV=/lsiopy \
    DISPLAY=:1 \
    PERL5LIB=/usr/local/bin \
    OMP_WAIT_POLICY=PASSIVE \
    GOMP_SPINCOUNT=0 \
    START_DOCKER=true \
    PULSE_RUNTIME_PATH=/defaults \
    NVIDIA_DRIVER_CAPABILITIES=all \
    NODE_ENV=production
EXPOSE 3000 3001
VOLUME /config
WORKDIR /
ENTRYPOINT ["/init"]
