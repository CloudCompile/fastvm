#!/usr/bin/with-contenv bash
# Optional user Node.js server. The project is persisted under /config so it
# can be supplied without rebuilding the FastVM image.

if [[ "${FASTVM_NODE_SERVER_ENABLED:-false}" != "true" ]]; then
    exec sleep 86400
fi

if ! command -v node >/dev/null 2>&1; then
    echo "[node-server] node not found; sleeping"
    exec sleep 86400
fi

app_dir="${FASTVM_NODE_SERVER_DIR:-/config/node-app}"
command="${FASTVM_NODE_SERVER_COMMAND:-npm start}"
port="${FASTVM_NODE_SERVER_PORT:-3002}"

if [[ ! -d "$app_dir" ]]; then
    echo "[node-server] app directory does not exist: ${app_dir}; sleeping"
    exec sleep 86400
fi

cd "$app_dir" || {
    echo "[node-server] unable to enter app directory: ${app_dir}; sleeping"
    exec sleep 86400
}

if [[ -f package.json && ! -d node_modules ]]; then
    echo "[node-server] installing dependencies in ${app_dir}"
    s6-setuidgid abc npm install --omit=dev --no-audit --no-fund 2>&1 || {
        echo "[node-server] npm install failed; sleeping"
        exec sleep 86400
    }
fi

export NODE_ENV="${NODE_ENV:-production}"
export PORT="$port"
export HOST="${FASTVM_NODE_SERVER_HOST:-0.0.0.0}"

echo "[node-server] starting ${command} on :${port}"
exec s6-setuidgid abc sh -c "exec ${command}"
