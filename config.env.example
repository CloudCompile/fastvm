# Copy this file to config.env, then adjust values for your host.
FASTVM_NAME=FastVM
FASTVM_PORT=3000
FASTVM_DASHBOARD_HOST_PORT=3001
FASTVM_DASHBOARD_PORT=8099
# FASTVM_DE options: XFCE4, KDE, GNOME, Cinnamon, LXQT, I3, Budgie, MATE, LXDE,
# Fluxbox, Unity, UbuntuStudio, Enlightenment, IceWM, awesome, UKUI, BSPWM,
# Herbstluftwm, JWM, FVWM, XMonad, Sugar, GNOME-Flashback, WMAKER, dwm,
# ratpoison, blackbox, pop-os, pekwm, spectrwm, sawfish, openbox, afterstep,
# ctwm, twm, nixos, pearos, fastvm-os
FASTVM_DE=XFCE4
FASTVM_PRESET=none
# Curated app bundle baked into the image. Precedence: FASTVM_APP_BUNDLE > preset > desktop default.
# Options: (empty=auto) | none | browser | essentials | communication | gaming | development | office | content-creation
FASTVM_APP_BUNDLE=
# Additive distro-flavor identity layer (standard | fastvm-os | ubuntu-studio | ubuntu-kylin | ubuntu-budgie | ubuntu-edubuntu | xubuntu | lubuntu | kubuntu | ubuntu-mate | ubuntu-unity | pop-os | linuxmint | kali | parrot | nixos | pearos)
FASTVM_OS_FLAVOR=standard
FASTVM_TZ=Etc/UTC
FASTVM_SHM_SIZE=4gb
# 0 = unlimited (container uses the whole machine). Discord/Electron is CPU and
# memory bound; a fixed cap starves it on larger hosts.
FASTVM_CPU_LIMIT=0
FASTVM_MEMORY_LIMIT=0
FASTVM_AUDIO_ENABLED=true
FASTVM_CLIPBOARD_ENABLED=true
FASTVM_RECORDING_ENABLED=true
FASTVM_RECORDING_FORMAT=mp4
# Software-encode codec (h264|hevc|vp9); hardware encoders always emit H.264.
FASTVM_RECORDING_CODEC=h264
FASTVM_RECORDING_BITRATE=5M
FASTVM_RECORDING_FRAMERATE=30
# GPU acceleration: encoder auto|nvenc|vaapi|qsv|software; drivers/selftest toggles
FASTVM_RECORDING_ENCODER=auto
FASTVM_ENABLE_GPU_DRIVERS=true
FASTVM_GPU_SELFTEST=true
# Compose overlay selection: false|true|intel|amd|nvidia
FASTVM_GPU=false
# GPU-rasterized desktop session (KasmVNC DRI3); disables compositing
FASTVM_GPU_HW=true
FASTVM_GPU_KEEP_COMPOSITING=false
# Compute-only accelerators (e.g. AMD Instinct MI300X) have no graphics engine.
# Set DISABLE_DRI=1 so KasmVNC does not attempt DRI3; FastVM auto-detects these
# and falls back to CPU rasterization + software encode regardless.
# DISABLE_DRI=1
FASTVM_BACKUP_ENABLED=true
FASTVM_BACKUP_AUTO_SCHEDULE=daily
FASTVM_BACKUP_RETENTION_DAYS=30
FASTVM_BACKUP_COMPRESSION=gzip
FASTVM_ALLOW_QUERY_TOKEN=false
FASTVM_PRIVILEGED=false
# Optional remote/rootless Docker daemon endpoint, e.g. tcp://127.0.0.1:2375
# FASTVM_DOCKER_HOST=tcp://127.0.0.1:2375
# Optional non-root CLI downloads used when Docker is absent from the panel image
# FASTVM_DOCKER_VERSION=27.3.1
# FASTVM_COMPOSE_VERSION=v2.29.7

# Optional gaming extras
FASTVM_APP_FLATPAK=false
FASTVM_APP_HEROIC=false
FASTVM_APP_MODRINTH=false