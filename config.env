# FastVM Configuration File
# Edit before running ./fastvm-install.sh
# All FASTVM_* variables are exported to the container automatically.

# =============================================================================
# NETWORK
# =============================================================================

# Main KasmVNC web interface (default: 3000)
FASTVM_PORT=3000

# Management dashboard HOST port — mapped to container-internal 8099 (default: 3001)
FASTVM_DASHBOARD_HOST_PORT=3001

# Dashboard listens on this port inside the container; the host port above is
# the port users connect to. Query-string tokens are disabled by default.
FASTVM_DASHBOARD_PORT=8099
FASTVM_ALLOW_QUERY_TOKEN=false

# Container name
FASTVM_NAME=FastVM

# =============================================================================
# USER
# =============================================================================

FASTVM_PUID=1000
FASTVM_PGID=1000

# Timezone — e.g. America/New_York, Europe/London, Asia/Tokyo
FASTVM_TZ=Etc/UTC

# =============================================================================
# RESOURCES
# =============================================================================

# Shared memory (increase for heavy apps / gaming)
FASTVM_SHM_SIZE=4gb

# CPU cores (0 = unlimited — the container sees the whole machine)
FASTVM_CPU_LIMIT=0

# RAM limit (0 = unlimited — the container sees the whole machine; e.g. 4g, 8g)
FASTVM_MEMORY_LIMIT=0

# =============================================================================
# DESKTOP ENVIRONMENT
# =============================================================================

# Options: KDE, XFCE4, I3, GNOME, Cinnamon, LXQT, Budgie, MATE, LXDE, Fluxbox, Unity, UbuntuStudio, Enlightenment, IceWM, awesome, UKUI, BSPWM, Herbstluftwm, JWM, FVWM, XMonad, Sugar, GNOME-Flashback, WMAKER, dwm, ratpoison, blackbox, pop-os, pekwm, spectrwm, sawfish, openbox, afterstep, ctwm, twm, nixos, pearos, fastvm-os
# Budgie  = modern, lightweight, recommended for 4 GB+ RAM
# MATE    = classic GNOME 2 continuation, moderate footprint
# LXDE    = ultra-light GTK2 desktop for low-resource hosts
# Fluxbox = minimal window manager (no desktop shell), lowest footprint
# Unity   = Ubuntu's classic shell (GNOME/Compiz based), moderate footprint
# UbuntuStudio = Ubuntu Studio flavor (KDE Plasma based) + distro identity layer
# Enlightenment = lightweight compositing desktop with a distinctive look
# IceWM   = very lightweight, taskbar + window manager, near-zero RAM
# awesome = scriptable tiling window manager (Lua), keyboard driven
# UKUI    = Ubuntu Kylin desktop (MATE/Qt hybrid), pairs with ubuntu-kylin flavor
# BSPWM   = binary-space-partitioning tiling WM with sxhkd hotkeys, ultra-light
# Herbstluftwm = manual tiling window manager (hlwm) with panels via dmenu, ultra-light
# JWM     = Joe's Window Manager, XML-configured stacking WM with taskbar/pager, ultra-light
# FVWM    = F? Virtual Window Manager, classic scriptable stacking WM with virtual desktops, light
# XMonad  = Haskell tiling window manager with xmobar status bar, keyboard-driven, very light
# Sugar   = Sugar Learning Platform (OLPC) activity shell, education-focused, GTK3
# GNOME-Flashback = classic GNOME 2 panel layout, pairs with ubuntu-edubuntu flavor
# WMAKER  = Window Maker, NeXTSTEP-style window manager, very light
# dwm     = dynamic window manager, suckless tiling WM (st + dmenu), ultra-light
# ratpoison = keyboard-driven tiling window manager (no mouse required), ultra-light
# blackbox = minimal stacking window manager with a right-click menu, ultra-light
# pop-os  = Pop!_OS (System76) GNOME Shell desktop + Pop GTK/icon themes, heavy
# pekwm   = PekWM, very lightweight stacking WM with a right-click root menu
# spectrwm = spectrwm, dynamic tiling WM (Xmonad/i3 inspired), keyboard driven, very light
# sawfish = Sawfish, Lisp-scriptable reparenting WM, configurable, light
# openbox = Openbox stacking WM with tint2 panel + rofi launcher, very light
# afterstep = AfterStep, NeXTSTEP-inspired stacking WM with Wharf/Pager, light
# ctwm    = Claude's Tab Window Manager, classic twm with virtual desktops, light
# twm     = Tom's Window Manager, the original X11 stacking WM, minimal
# nixos   = NixOS flavor shell (Openbox + Nix package manager), pairs with nixos flavor
# pearos  = pearOS macOS-inspired KDE Plasma desktop, pairs with pearos flavor
# fastvm-os = FastVM OS Openbox/Tint2 appliance shell
FASTVM_DE=XFCE4

# =============================================================================
# PRESET (optional — overlays app + resource defaults)
# =============================================================================

# Options: none, minimal, gaming, development, office, content-creation, hidencloud-free-vps
# When a preset is set, it overrides individual app selections below.
FASTVM_PRESET=none

# =============================================================================
# APPLICATION BUNDLE (curated app set for the image)
# =============================================================================

# The bundle decides which apps are baked into the image. Precedence:
#   FASTVM_APP_BUNDLE  >  preset bundle  >  desktop default
# Individual FASTVM_APP_* / FASTVM_PROG_* toggles below are additive on top.
#
# Options:
#   (empty)          use the preset/desktop default (recommended)
#   none             no apps
#   browser          Chrome only
#   essentials       Chrome + Xarchiver + VLC (default for full desktops)
#   communication    Chrome + Discord
#   gaming           Wine + Steam + Heroic + launchers + Discord + Chrome
#   development      VSCodium + Chrome + Java 17 + Flatpak
#   office           LibreOffice + Chrome + Xarchiver
#   content-creation Chrome + VLC + Flatpak + Discord
FASTVM_APP_BUNDLE=

# =============================================================================
# APPLICATION SELECTION
# =============================================================================

# Default Apps
FASTVM_APP_WINE=true
FASTVM_APP_CHROME=true
FASTVM_APP_XARCHIVER=false
FASTVM_APP_DISCORD=false
FASTVM_APP_STEAM=false
FASTVM_APP_MINECRAFT=false

# Programming Tools
FASTVM_PROG_JAVA8=false
FASTVM_PROG_JAVA17=false
FASTVM_PROG_VSCODIUM=false

# Additional Apps
FASTVM_APP_VLC=false
FASTVM_APP_LIBREOFFICE=false
FASTVM_APP_SYNAPTIC=false
FASTVM_APP_AQEMU=false
FASTVM_APP_TLAUNCHER=false
FASTVM_APP_FLATPAK=false
FASTVM_APP_HEROIC=false
FASTVM_APP_MODRINTH=false

# =============================================================================
# AUDIO
# =============================================================================

# Enable PulseAudio inside the container (true/false)
FASTVM_AUDIO_ENABLED=true

# =============================================================================
# CLIPBOARD SYNC
# =============================================================================

# Bidirectional clipboard between browser and desktop (true/false)
FASTVM_CLIPBOARD_ENABLED=true

# =============================================================================
# SCREEN RECORDING
# =============================================================================

FASTVM_RECORDING_ENABLED=true

# Output format: mp4, webm, mkv
FASTVM_RECORDING_FORMAT=mp4

# Video bitrate
FASTVM_RECORDING_BITRATE=5M

# Frames per second
FASTVM_RECORDING_FRAMERATE=30

# Codec for software encoding: h264, hevc, vp9. Hardware encoders always emit
# H.264 (see FASTVM_RECORDING_ENCODER below).
FASTVM_RECORDING_CODEC=h264

# =============================================================================
# GPU ACCELERATION
# =============================================================================

# Encoder for screen recording / streaming. "auto" uses the GPU detected at
# startup (NVENC/VAAPI/QSV) and falls back to software (libx264). Force one of:
# auto, nvenc, vaapi, qsv, software.
FASTVM_RECORDING_ENCODER=auto

# Install VA-API/Mesa/Vulkan userspace drivers at build time (Intel/AMD).
FASTVM_ENABLE_GPU_DRIVERS=true

# Run a short encoder self-test at container startup and log the result.
FASTVM_GPU_SELFTEST=true

# Enable GPU device mapping via the compose overlays when running
# ./fastvm-install.sh. Values: false (default), true|intel|amd (maps /dev/dri for
# VA-API/QSV), nvidia (NVIDIA device reservation; needs the container toolkit).
FASTVM_GPU=false

# Opt in to a GPU-rasterized desktop session (KasmVNC DRI3 + per-session userspace
# env). The base image already passes -hw3d when /dev/dri is mapped; this also
# applies the session variables that let apps use the GPU and disables the
# compositor on XFCE/KDE/MATE (DRI3 cannot composite). See docs/gpu.md.
FASTVM_GPU_HW=true

# Keep desktop compositing even when GPU rasterization is enabled. Compositing
# forces the desktop back to CPU (llvmpipe) rendering; enable this only if you
# need window effects and accept that trade-off.
FASTVM_GPU_KEEP_COMPOSITING=false

# DRM render node to use on multi-GPU hosts (default /dev/dri/renderD128).
# DRINODE=/dev/dri/renderD128

# Stop KasmVNC from enabling DRI3 GPU rasterization. Set this to 1 on hosts
# whose GPU has no graphics engine (e.g. AMD Instinct MI300X): the desktop then
# renders on the CPU (llvmpipe). FastVM detects such GPUs automatically, but
# setting DISABLE_DRI=1 guarantees a clean session. See docs/gpu.md.
# DISABLE_DRI=1

# =============================================================================
# SNAPSHOT / BACKUP
# =============================================================================

# Master switch
FASTVM_BACKUP_ENABLED=true

# Automatic schedule: disabled, daily, weekly, hourly
FASTVM_BACKUP_AUTO_SCHEDULE=daily

# Days to keep old snapshots (0 = keep forever)
FASTVM_BACKUP_RETENTION_DAYS=30

# Compression: gzip, zstd, xz
FASTVM_BACKUP_COMPRESSION=gzip

# =============================================================================
# AUTO-SCALING
# =============================================================================

# Dynamically adjust CPU/memory limits (disabled by default — opt-in)
FASTVM_AUTOSCALE_ENABLED=false
FASTVM_AUTOSCALE_MIN_CPU=1
FASTVM_AUTOSCALE_MAX_CPU=4
FASTVM_AUTOSCALE_MIN_MEMORY=2g
FASTVM_AUTOSCALE_MAX_MEMORY=8g
FASTVM_AUTOSCALE_CPU_THRESHOLD=80
FASTVM_AUTOSCALE_MEMORY_THRESHOLD=80
FASTVM_AUTOSCALE_INTERVAL=30

# =============================================================================
# FEATURES
# =============================================================================

# URL subfolder path (default: /)
FASTVM_SUBFOLDER=/

# Browser tab title
FASTVM_TITLE=FastVM

# Additive distro-flavor identity layer (never replaces the Ubuntu 22.04 base).
# Options: standard (default, no-op), fastvm-os, ubuntu-studio, ubuntu-kylin, ubuntu-budgie, ubuntu-edubuntu, xubuntu, lubuntu, kubuntu, ubuntu-mate, ubuntu-unity, pop-os, linuxmint, kali, parrot, nixos, pearos
# ubuntu-studio pairs with FASTVM_DE=UbuntuStudio to label the image as the
# Ubuntu Studio 22.04 LTS multimedia flavor.
# ubuntu-kylin pairs with FASTVM_DE=UKUI to label the image as the Ubuntu
# Kylin 22.04 LTS flavor.
# ubuntu-budgie pairs with FASTVM_DE=Budgie to label the image as the Ubuntu
# Budgie 22.04 LTS flavor.
# ubuntu-edubuntu pairs with FASTVM_DE=GNOME to label the image as the Ubuntu
# Edubuntu 22.04 LTS education flavor.
# xubuntu pairs with FASTVM_DE=XFCE4 to label the image as the Xubuntu
# 22.04 LTS lightweight XFCE flavor.
# lubuntu pairs with FASTVM_DE=LXQT to label the image as the Lubuntu
# 22.04 LTS lightweight LXQt flavor.
# kubuntu pairs with FASTVM_DE=KDE to label the image as the Kubuntu
# 22.04 LTS KDE Plasma flavor.
# ubuntu-mate pairs with FASTVM_DE=MATE to label the image as the Ubuntu
# MATE 22.04 LTS flavor.
# ubuntu-unity pairs with FASTVM_DE=Unity to label the image as the Ubuntu
# Unity 22.04 LTS flavor.
# pop-os pairs with FASTVM_DE=pop-os to label the image as the Pop!_OS 22.04
# LTS (System76) GNOME flavor.
# linuxmint pairs with FASTVM_DE=Cinnamon to label the image as the Linux Mint
# 21 (Cinnamon) flavor.
# kali pairs with FASTVM_DE=XFCE4 to label the image as the Kali Linux
# security-focused flavor (Ubuntu 22.04 base, Kali identity layer).
# parrot pairs with FASTVM_DE=MATE to label the image as the Parrot Security OS
# security/privacy flavor (Ubuntu 22.04 base, Parrot identity layer).
# nixos pairs with FASTVM_DE=nixos to label the image as the NixOS flavor
# (declarative distro identity + Nix package manager on the Ubuntu 22.04 base).
# pearos pairs with FASTVM_DE=pearos to label the image as the pearOS flavor
# (macOS-inspired KDE Plasma identity on the Ubuntu 22.04 base).
FASTVM_OS_FLAVOR=standard

# Enable KVM acceleration (requires /dev/kvm on host)
FASTVM_ENABLE_KVM=false

# =============================================================================
# ADVANCED
# =============================================================================

# Restart policy: no, on-failure, always, unless-stopped
FASTVM_RESTART_POLICY=on-failure

# Disable health checks
FASTVM_HEALTHCHECK_DISABLE=false

FASTVM_HEALTH_INTERVAL=30s
FASTVM_HEALTH_TIMEOUT=10s

# Log level: debug, info, warn, error
FASTVM_LOG_LEVEL=info

# Compatibility escape hatch; keep false unless privileged device access is required.
FASTVM_PRIVILEGED=false
