FROM ghcr.io/linuxserver/baseimage-kasmvnc:ubuntujammy

# =============================================================================
# Build Arguments and Labels
# =============================================================================
ARG BUILD_DATE
ARG VERSION
LABEL org.opencontainers.image.title="FastVM" \
    org.opencontainers.image.description="Linux desktop streaming platform with an optional FastVM OS shell" \
    org.opencontainers.image.source="https://github.com/CloudCompile/fastvm" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    maintainer="fastvm"

# =============================================================================
# Environment Setup
# =============================================================================
ARG DEBIAN_FRONTEND="noninteractive"
ARG FASTVM_DE=XFCE4
ARG FASTVM_PRESET=none
ARG FASTVM_APP_BUNDLE=""
ARG FASTVM_APP_WINE=false
ARG FASTVM_APP_CHROME=false
ARG FASTVM_APP_XARCHIVER=false
ARG FASTVM_APP_DISCORD=false
ARG FASTVM_APP_STEAM=false
ARG FASTVM_APP_MINECRAFT=false
ARG FASTVM_APP_VLC=false
ARG FASTVM_APP_LIBREOFFICE=false
ARG FASTVM_APP_SYNAPTIC=false
ARG FASTVM_APP_AQEMU=false
ARG FASTVM_APP_TLAUNCHER=false
ARG FASTVM_APP_FLATPAK=false
ARG FASTVM_APP_HEROIC=false
ARG FASTVM_APP_MODRINTH=false
ARG FASTVM_PROG_JAVA8=false
ARG FASTVM_PROG_JAVA17=false
ARG FASTVM_PROG_VSCODIUM=false
ARG FASTVM_SINGLEAPP_CMD=""
ARG FASTVM_SINGLEAPP_SCRIPT=""
ARG FASTVM_OS_FLAVOR="standard"
ARG FASTVM_ENABLE_GPU_DRIVERS="true"
ENV FASTVM_DE=${FASTVM_DE}
ENV FASTVM_PRESET=${FASTVM_PRESET}
ENV FASTVM_APP_BUNDLE=${FASTVM_APP_BUNDLE}
ENV FASTVM_APP_WINE=${FASTVM_APP_WINE}
ENV FASTVM_APP_CHROME=${FASTVM_APP_CHROME}
ENV FASTVM_APP_XARCHIVER=${FASTVM_APP_XARCHIVER}
ENV FASTVM_APP_DISCORD=${FASTVM_APP_DISCORD}
ENV FASTVM_APP_STEAM=${FASTVM_APP_STEAM}
ENV FASTVM_APP_MINECRAFT=${FASTVM_APP_MINECRAFT}
ENV FASTVM_APP_VLC=${FASTVM_APP_VLC}
ENV FASTVM_APP_LIBREOFFICE=${FASTVM_APP_LIBREOFFICE}
ENV FASTVM_APP_SYNAPTIC=${FASTVM_APP_SYNAPTIC}
ENV FASTVM_APP_AQEMU=${FASTVM_APP_AQEMU}
ENV FASTVM_APP_TLAUNCHER=${FASTVM_APP_TLAUNCHER}
ENV FASTVM_APP_FLATPAK=${FASTVM_APP_FLATPAK}
ENV FASTVM_APP_HEROIC=${FASTVM_APP_HEROIC}
ENV FASTVM_APP_MODRINTH=${FASTVM_APP_MODRINTH}
ENV FASTVM_PROG_JAVA8=${FASTVM_PROG_JAVA8}
ENV FASTVM_PROG_JAVA17=${FASTVM_PROG_JAVA17}
ENV FASTVM_PROG_VSCODIUM=${FASTVM_PROG_VSCODIUM}
ENV FASTVM_SINGLEAPP_CMD=${FASTVM_SINGLEAPP_CMD}
ENV FASTVM_SINGLEAPP_SCRIPT=${FASTVM_SINGLEAPP_SCRIPT}
ENV FASTVM_OS_FLAVOR=${FASTVM_OS_FLAVOR}
ENV FASTVM_ENABLE_GPU_DRIVERS=${FASTVM_ENABLE_GPU_DRIVERS}
ENV NODE_ENV=production

# =============================================================================
# Layer 1: Base Configuration Files
# =============================================================================
COPY root/ /

# =============================================================================
# Layer 2: System Dependencies
# =============================================================================
RUN set -eu && \
    echo "**** Installing base dependencies ****" && \
    rm -f /etc/apt/sources.list.d/nodesource.list || true && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        software-properties-common && \
    add-apt-repository -y universe multiverse && \
    add-apt-repository -y ppa:mozillateam/ppa && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        jq wget curl ca-certificates apt-transport-https \
        pulseaudio pulseaudio-utils libpulse0 \
        ffmpeg x11-utils \
        xclip xsel \
        cron zstd \
        procps net-tools && \
    rm -rf /var/lib/apt/lists/*

# =============================================================================
# Layer 3: Desktop Environment
# =============================================================================
COPY fastvm-setup.sh /fastvm-setup.sh
RUN chmod +x /fastvm-setup.sh && \
    /fastvm-setup.sh && \
    rm /fastvm-setup.sh

# =============================================================================
# Layer 4: Applications (parallel installation)
# =============================================================================
COPY scripts/render-options-json.py /render-options-json.py
COPY installapps-parallel.sh /installapps-parallel.sh
COPY installable-apps/ /installable-apps/
RUN chmod +x /installapps-parallel.sh /render-options-json.py && \
    python3 /render-options-json.py /dev/null /options.json && \
    cat /options.json && \
    /installapps-parallel.sh && \
    rm /installapps-parallel.sh /installable-apps /render-options-json.py -rf

# =============================================================================
# Layer 5: FastVM Scripts
# =============================================================================
COPY scripts/ /opt/fastvm-scripts/
RUN chmod +x /opt/fastvm-scripts/*.sh

# =============================================================================
# Layer 6: Management Dashboard
# =============================================================================
COPY dashboard/ /opt/fastvm-dashboard/
WORKDIR /opt/fastvm-dashboard
RUN \
    npm install --omit=dev --no-audit --no-fund && \
    npm cache clean --force

# =============================================================================
# Layer 7: Preset hooks
# =============================================================================
COPY presets/ /opt/fastvm-presets/

# =============================================================================
# Layer 8: Optional FastVM OS identity and appliance defaults
# =============================================================================
COPY fastvm-os/ /opt/fastvm-os/
RUN chmod +x /opt/fastvm-os/install.sh && \
    /opt/fastvm-os/install.sh "${FASTVM_OS_FLAVOR}"

# =============================================================================
# Layer 9: Final Cleanup
# =============================================================================
RUN set -eu && \
    echo "**** Final cleanup ****" && \
    apt-get autoclean && \
    apt-get autoremove -y && \
    rm -rf \
        /config/.cache \
        /var/lib/apt/lists/* \
        /var/tmp/* \
        /tmp/* \
        /var/log/* \
        /usr/share/doc/* \
        /usr/share/man/* && \
    # Runtime directories
    mkdir -p /var/log/fastvm /config /config/backups /config/recordings \
             /config/.fastvm /var/log/nginx && \
    chown -R 1000:1000 /config && \
    chown -R www-data:www-data /var/log/nginx && \
    # Make service scripts executable
    chmod +x /etc/cont-init.d/99-fastvm-init \
             /etc/services.d/fastvm-dashboard/run 2>/dev/null || true

# =============================================================================
# Runtime Configuration
# =============================================================================
EXPOSE 3000 8099 3002
VOLUME /config

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8099/api/health
