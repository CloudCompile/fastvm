{
  // FastVM on GitHub Codespaces.
  //
  // FastVM runs a streamed Linux desktop inside Docker, so a Codespace needs
  // Docker-in-Docker. We pull the published image for the default desktop
  // (xfce4) instead of building it, which is the difference between a ~1 minute
  // start and a ~30 minute one on a fresh machine.
  //
  //   Desktop (KasmVNC) : port 3000  -> opens automatically
  //   Dashboard         : port 3001
  //
  // Change the desktop/preset by editing FASTVM_DE / FASTVM_PRESET (and
  // FASTVM_IMAGE) below; see docs/performance.md for small-machine tuning and
  // docs/codespaces.md for the full guide.
  "name": "FastVM Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 2 cores / 8 GB is the free tier and works (FastVM auto-tunes for it);
  // 4 cores / 16 GB is smoother. Keep the requirement at the free tier so the
  // default Codespace can create — asking for 4 cores would block it.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "containerEnv": {
    "FASTVM_IMAGE": "ghcr.io/cloudcompile/fastvm:xfce4-none-latest",
    "FASTVM_DE": "XFCE4",
    "FASTVM_PRESET": "none"
  },

  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": {
      "label": "FastVM Desktop",
      "onAutoForward": "openBrowser"
    },
    "3001": {
      "label": "FastVM Dashboard",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  },

  // onCreate runs during prebuild and is snapshotted, so prebuilding this repo
  // makes the (large) image pull free on every future Codespace. Pull only -
  // starting a container here would be discarded at prebuild time.
  "onCreateCommand": "docker pull \"$(./fastvm-install.sh --print-image | tail -1)\"",

  // postCreate runs once per Codespace: the image is already present, so this
  // just starts FastVM. It falls back to a build if the pull did not happen.
  "postCreateCommand": "./fastvm-install.sh --no-build || ./fastvm-install.sh",

  // postStart runs on every resume (idle timeout, reload). --no-recreate starts
  // the existing container without reconciling compose config: this shell does
  // not source config.env, so a plain `up -d` would recompute defaults and
  // silently recreate the container, discarding config.env customisations.
  "postStartCommand": "docker compose up -d --no-recreate",

  "remoteUser": "vscode"
}
