ARG FASTVM_BASE_IMAGE=ghcr.io/cloudcompile/fastvm-base:alpha
FROM ${FASTVM_BASE_IMAGE}

ARG FASTVM_PRESET=none
ARG FASTVM_DE=XFCE4
ARG FASTVM_OS_FLAVOR=standard
ARG FASTVM_ENABLE_GPU_DRIVERS=true
ARG FASTVM_APP_BUNDLE=
ARG FASTVM_APP_WINE=false
ARG FASTVM_APP_CHROME=false
ARG FASTVM_APP_XARCHIVER=false
ARG FASTVM_APP_DISCORD=false
ARG FASTVM_APP_STEAM=false
ARG FASTVM_APP_MINECRAFT=false
ARG FASTVM_APP_VLC=false
ARG FASTVM_APP_LIBREOFFICE=false
ARG FASTVM_APP_SYNAPTIC=false
ARG FASTVM_APP_AQEMU=false
ARG FASTVM_APP_TLAUNCHER=false
ARG FASTVM_APP_FLATPAK=false
ARG FASTVM_APP_HEROIC=false
ARG FASTVM_APP_MODRINTH=false
ARG FASTVM_PROG_JAVA8=false
ARG FASTVM_PROG_JAVA17=false
ARG FASTVM_PROG_VSCODIUM=false
ARG FASTVM_SINGLEAPP_CMD=
ARG FASTVM_SINGLEAPP_SCRIPT=

ENV FASTVM_PRESET=${FASTVM_PRESET} \
    FASTVM_DE=${FASTVM_DE} \
    FASTVM_OS_FLAVOR=${FASTVM_OS_FLAVOR} \
    FASTVM_ENABLE_GPU_DRIVERS=${FASTVM_ENABLE_GPU_DRIVERS} \
    FASTVM_INSTALL_PARALLELISM=1 \
    FASTVM_APP_BUNDLE=${FASTVM_APP_BUNDLE} \
    FASTVM_APP_WINE=${FASTVM_APP_WINE} \
    FASTVM_APP_CHROME=${FASTVM_APP_CHROME} \
    FASTVM_APP_XARCHIVER=${FASTVM_APP_XARCHIVER} \
    FASTVM_APP_DISCORD=${FASTVM_APP_DISCORD} \
    FASTVM_APP_STEAM=${FASTVM_APP_STEAM} \
    FASTVM_APP_MINECRAFT=${FASTVM_APP_MINECRAFT} \
    FASTVM_APP_VLC=${FASTVM_APP_VLC} \
    FASTVM_APP_LIBREOFFICE=${FASTVM_APP_LIBREOFFICE} \
    FASTVM_APP_SYNAPTIC=${FASTVM_APP_SYNAPTIC} \
    FASTVM_APP_AQEMU=${FASTVM_APP_AQEMU} \
    FASTVM_APP_TLAUNCHER=${FASTVM_APP_TLAUNCHER} \
    FASTVM_APP_FLATPAK=${FASTVM_APP_FLATPAK} \
    FASTVM_APP_HEROIC=${FASTVM_APP_HEROIC} \
    FASTVM_APP_MODRINTH=${FASTVM_APP_MODRINTH} \
    FASTVM_PROG_JAVA8=${FASTVM_PROG_JAVA8} \
    FASTVM_PROG_JAVA17=${FASTVM_PROG_JAVA17} \
    FASTVM_PROG_VSCODIUM=${FASTVM_PROG_VSCODIUM} \
    FASTVM_SINGLEAPP_CMD=${FASTVM_SINGLEAPP_CMD} \
    FASTVM_SINGLEAPP_SCRIPT=${FASTVM_SINGLEAPP_SCRIPT}

COPY fastvm-setup.sh /fastvm-setup.sh
RUN chmod +x /fastvm-setup.sh && /fastvm-setup.sh && rm -f /fastvm-setup.sh

COPY scripts/render-options-json.py /render-options-json.py
COPY installapps-parallel.sh /installapps-parallel.sh
COPY installable-apps/ /installable-apps/
RUN chmod +x /installapps-parallel.sh /render-options-json.py && \
    apt-get update && \
    python3 /render-options-json.py /dev/null /options.json && \
    /installapps-parallel.sh && \
    rm -rf /installapps-parallel.sh /installable-apps /render-options-json.py \
      /var/lib/apt/lists/* /var/tmp/* /tmp/*

COPY presets/ /opt/fastvm-presets/

COPY fastvm-os/ /opt/fastvm-os/
RUN chmod +x /opt/fastvm-os/install.sh && /opt/fastvm-os/install.sh "${FASTVM_OS_FLAVOR}"
